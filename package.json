{
  "name": "pi-interactive-subagents",
  "version": "2.1.0",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in psmux, WezTerm, or Warp terminals (Linux + Windows)",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "HazAT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HazAT/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "warp:hook": "node scripts/install-warp-hook.mjs",
    "test:integration:warp": "node --test test/integration/warp-surface.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts",
      "./pi-extension/session-artifacts/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "^0.85.0",
    "@sinclair/typebox": "^0.34.49"
  }
}
